# ==============================================================================
# AI Assistant Server Configuration
# ==============================================================================

# Server Port (AI Studio runtime uses 3000)
PORT=3000
NODE_ENV=development

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# LLM Provider (OpenRouter / OpenAI-compatible: Groq, Gemini, etc.)
# ==============================================================================
LLM_PROVIDER="auto"
OPENROUTER_API_KEY=""
LLM_BASE_URL="https://openrouter.ai/api/v1"

# Model Routing (override to switch providers/models with zero code changes)
MODEL_FAST="openai/gpt-4o-mini"
MODEL_STRONG="openai/gpt-4o"
MODEL_VISION="openai/gpt-4o-mini"
MODEL_EMBEDDING="openai/text-embedding-3-small"
MODEL_FALLBACK="google/gemini-2.0-flash-001"
LLM_TIMEOUT_MS=25000

# Optional secondary provider keys (automatic failover: OpenRouter -> Groq -> Gemini)
GROQ_API_KEY=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# Vector Store (Supabase pgvector primary, automatic in-memory fallback for dev)
# ==============================================================================
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
VECTOR_STORE_MODE="auto"

# ==============================================================================
# Security, Auth & Limits
# ==============================================================================
JWT_SECRET="dev-change-this-secret-in-production"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_IP=60
RATE_LIMIT_MAX_USER=40
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=5000
RESPONSE_CACHE_TTL_MS=300000
CONFIRMATION_SECRET="dev-confirm-hmac-secret"
PROFILES_DIR="./profiles"
LOG_LEVEL="info"
